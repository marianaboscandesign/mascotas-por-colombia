# ─────────────────────────────────────────────────────────────
# Mascotas por Colombia — Variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# Nunca subas `.env.local` al repositorio.
# ─────────────────────────────────────────────────────────────

# URL pública del proyecto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave pública anónima (Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave de servicio — SOLO para uso en el servidor (jobs, scripts admin).
# NUNCA la expongas en el cliente. Déjala fuera si no la necesitas todavía.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL base del sitio (para SEO, sitemap, metadatos canónicos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contraseña para la edición rápida desde la ficha (pública, protección débil)
NEXT_PUBLIC_EDIT_PASSWORD=cambia-esto

# Google Cloud Vertex AI (autollenado + búsqueda por foto + fichas)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# El CONTENIDO completo del JSON de la cuenta de servicio, en una sola línea
# y entre comillas simples. Funciona tanto en local como en Vercel.
# Es un secreto de servidor: nunca uses el prefijo NEXT_PUBLIC_ ni lo subas a Git.
GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-google-cloud-project-id","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'
